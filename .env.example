# Solana RPC. Public mainnet WILL rate-limit getProgramAccounts -- use a private one.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE_ME
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=REPLACE_ME

# Bitquery -- Phase 0 historical tape only. Free trial is enough to start.
BITQUERY_TOKEN=REPLACE_ME

# DFlow -- REQUIRED for any live trading. 2-5 day approval, apply early.
DFLOW_API_KEY=REPLACE_ME

# BTC spot feed for the volatility gate.
BTC_FEED=binance

# Bot wallet keypair path. YOU generate this. Never a main wallet.
KEYPAIR_PATH=
